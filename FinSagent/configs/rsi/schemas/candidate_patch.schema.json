{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finsagent-rsi-candidate-patch/v1",
  "type": "object",
  "required": ["candidate_id", "cluster_id", "mutation_level", "hypothesis", "expected_mechanism", "target_paths", "status"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "cluster_id": {"type": "string", "minLength": 1},
    "mutation_level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
    "hypothesis": {"type": "string", "minLength": 8},
    "expected_mechanism": {"type": "string", "minLength": 8},
    "target_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["proposed", "sandboxed", "evaluated", "rejected", "eligible_for_human_review", "promoted", "rolled_back"]}
  },
  "additionalProperties": true
}
