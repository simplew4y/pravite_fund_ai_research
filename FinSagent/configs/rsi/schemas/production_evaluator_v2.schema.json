{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finsagent-rsi-production-evaluator/v2",
  "type": "object",
  "required": ["case_id", "suite", "capability", "company", "target", "rubric", "evidence_refs", "provenance"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "suite": {"enum": ["targeted", "negative_noop", "fresh_internal", "protected"]},
    "target": {"type": "object", "required": ["question"], "properties": {"question": {"type": "string", "minLength": 8}}},
    "rubric": {"type": "object", "required": ["ground_truth_answer", "key_points", "critical_errors"]},
    "evidence_refs": {"type": "array", "minItems": 1},
    "provenance": {"type": "object", "required": ["source_dataset_sha256", "source_record_id"]}
  }
}
