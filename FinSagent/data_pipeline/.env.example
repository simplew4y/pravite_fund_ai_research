
LLM_MODEL_NAME=deepseek-v4-pro
LLM_API_KEY=API_KEY
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Single Anthropic API key (fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: multiple Anthropic API keys; the data pipeline will pick a random
# key for each LLM call. Use either of the formats below.
#
# 1) Comma- or whitespace-separated list:
# ANTHROPIC_API_KEYS=key1,key2,key3
#
# 2) Numbered keys:
# ANTHROPIC_API_KEY_1=key1
# ANTHROPIC_API_KEY_2=key2
# ANTHROPIC_API_KEY_3=key3

TENCENT_API_KEY=your_tencent_api_key_here
