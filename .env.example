# Tushare-compatible market-data provider for deterministic valuation refreshes.
PRIVATE_FUND_MARKET_DATA_PROVIDER=hybrid
TUSHARE_TOKEN=replace-with-local-secret
TUSHARE_API_URL=https://api.tushare.pro

# Keep below the account-wide request limit and reuse duplicate company queries.
TUSHARE_MIN_INTERVAL_SECONDS=0.45
TUSHARE_CACHE_TTL_SECONDS=300
TUSHARE_REQUEST_ATTEMPTS=3

# One idempotent refresh per interval; uploads still refresh immediately.
PRIVATE_FUND_MARKET_REFRESH_INTERVAL_MINUTES=60
PRIVATE_FUND_MARKET_REFRESH_TIMEZONE=Asia/Shanghai
