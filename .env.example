# Tushare-compatible market-data provider for deterministic valuation refreshes.
PRIVATE_FUND_MARKET_DATA_PROVIDER=hybrid
TUSHARE_TOKEN=replace-with-local-secret
TUSHARE_API_URL=https://api.tushare.pro

# Keep below the account-wide request limit and reuse duplicate company queries.
TUSHARE_MIN_INTERVAL_SECONDS=0.45
TUSHARE_CACHE_TTL_SECONDS=300
TUSHARE_REQUEST_ATTEMPTS=3

# One idempotent refresh per interval; uploads still refresh immediately.
PRIVATE_FUND_MARKET_REFRESH_INTERVAL_MINUTES=60
PRIVATE_FUND_MARKET_REFRESH_TIMEZONE=Asia/Shanghai

# Unified uploads use the current user's configured model to jointly verify the
# controlled document type and primary subject company. Disable only for an
# offline rules-only fallback; the default is enabled.
PRIVATE_FUND_USE_LLM=1
PRIVATE_FUND_DOCUMENT_CLASSIFIER_USE_LLM=1

# Cloud account service. The browser only talks to the local Omnigent BFF;
# cloud access and refresh tokens stay in encrypted HttpOnly cookies.
OMNIGENT_AUTH_ENABLED=1
OMNIGENT_AUTH_PROVIDER=cloud_accounts
OMNIGENT_CLOUD_BACKEND_URL=https://capoo.fun/private_fund/backend
OMNIGENT_CLOUD_REQUEST_TIMEOUT_SECONDS=10
OMNIGENT_CLOUD_UPLOAD_TIMEOUT_SECONDS=180
OMNIGENT_CLOUD_REGISTRATION_ENABLED=1

# Local Omnigent session signing key. Generate with: openssl rand -hex 32
# manage_omnigent_services.sh generates and persists this automatically.
OMNIGENT_ACCOUNTS_COOKIE_SECRET=replace-with-64-hex-characters
OMNIGENT_ACCOUNTS_BASE_URL=http://127.0.0.1:6768
