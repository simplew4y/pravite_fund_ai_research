+def test_inject_user_message_advances_startup_continue_prompt(
+    tmp_path: Path,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """
+    Startup announcement pages are advanced before the prompt wait times out.
+
+    Some Claude Code launchers show an announcement screen that blocks on
+    ``Press Enter to continue...`` before rendering the real input prompt.
+    The bridge should send only that acknowledgement Enter while blocked,
+    then wait for ``❯`` before delivering the user's message.
+    """
+    monkeypatch.setattr("omnigent.claude_native_bridge._TRUSTED_PARENT", tmp_path)
+    monkeypatch.setattr("omnigent.claude_native_bridge._CLAUDE_READY_POLL_INTERVAL_S", 0.01)
+    monkeypatch.setattr(
+        "omnigent.claude_native_bridge._CLAUDE_CONTINUE_PROMPT_ENTER_COOLDOWN_S",
+        0.0,
+    )
+    bridge_dir = tmp_path / "bridge"
+    write_tmux_target(
+        bridge_dir,
+        socket_path=Path("/tmp/example/tmux.sock"),
+        tmux_target="claude:0.0",
+    )
+
+    calls: list[list[str]] = []
+    tui = {
+        "phase": "announcement",
+        "pane": "ANNOUNCEMENTS\nPress Enter to continue...",
+    }
+
+    def _fake_run(cmd: list[str], **kwargs: object) -> SimpleNamespace:
+        """
+        Simulate a launcher announcement followed by Claude's prompt.
+
+        :param cmd: Argv list passed to subprocess.run.
+        :param kwargs: Subprocess kwargs (ignored).
+        :returns: Fake CompletedProcess; capture-pane returns the simulated
+            pane, other calls return rc=0.
+        """
+        del kwargs
+        if "capture-pane" in cmd:
+            return SimpleNamespace(returncode=0, stdout=tui["pane"], stderr="")
+        if tui["phase"] == "announcement":
+            assert cmd[-1] == "Enter", f"unexpected key before prompt rendered: {cmd}"
+            tui["phase"] = "ready"
+            tui["pane"] = "❯ "
+        elif "paste-buffer" in cmd:
+            tui["pane"] = "❯ hello"
+        elif cmd[-1] == "Enter":
+            tui["pane"] = "❯ "
+        calls.append(cmd)
+        return SimpleNamespace(returncode=0, stdout="", stderr="")
+
+    monkeypatch.setattr("subprocess.run", _fake_run)
+    inject_user_message(bridge_dir, content="hello")
+
+    assert len(calls) == 6, (
+        f"Expected announcement Enter + 5 delivery calls, got {len(calls)} call(s)."
+    )
+    announcement_enter, clear_home, clear_kill, load, paste, submit = calls
+    assert announcement_enter[-1] == "Enter"
+    assert clear_home[-1] == "C-a"
+    assert clear_kill[-1] == "C-k"
+    assert load[3] == "load-buffer"
+    assert paste[3] == "paste-buffer"
+    assert submit[-1] == "Enter"
+
