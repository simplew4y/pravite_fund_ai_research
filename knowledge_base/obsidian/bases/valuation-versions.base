filters:
  and:
    - 'file.hasTag("private-fund")'
    - 'managed_by == "omnigent"'
    - or:
        - 'entity_type == "valuation-series"'
        - 'entity_type == "valuation-version"'
        - 'entity_type == "valuation-change"'
        - 'entity_type == "valuation-agent-analysis"'
        - 'entity_type == "valuation-derived"'

formulas:
  entry: 'link(file.path, title)'

properties:
  formula.entry:
    displayName: "条目"
  company:
    displayName: "公司"
  version_no:
    displayName: "版本"
  target_price:
    displayName: "目标价"
  wacc:
    displayName: "WACC"
  terminal_growth:
    displayName: "永续增长"
  change_level:
    displayName: "变化级别"
  review_state:
    displayName: "复核"
  current_version_label:
    displayName: "当前版本"
  decision_status:
    displayName: "阅读状态"
  evidence_coverage:
    displayName: "证据覆盖"
  current_summary:
    displayName: "当前结论"
  change_summary:
    displayName: "变化摘要"
  quarantined_node_count:
    displayName: "隔离节点"
  quarantined_change_count:
    displayName: "隔离变化"
  focus:
    displayName: "分析重点"
  analysis_summary:
    displayName: "分析摘要"

views:
  - type: table
    name: "当前模型"
    filters:
      and:
        - 'entity_type == "valuation-series"'
    order:
      - formula.entry
      - company
      - current_version_label
      - current_summary
      - decision_status
      - evidence_coverage
      - quarantined_node_count

  - type: table
    name: "模型版本"
    filters:
      and:
        - 'entity_type == "valuation-version"'
    groupBy:
      property: valuation_series_id
      direction: ASC
    order:
      - formula.entry
      - version_no
      - valuation_date
      - target_price
      - decision_status
      - evidence_coverage

  - type: table
    name: "可解释变化"
    filters:
      and:
        - 'entity_type == "valuation-change"'
        - 'change_level != "none"'
    order:
      - formula.entry
      - company
      - change_level
      - change_summary
      - quarantined_change_count

  - type: table
    name: "Agent 分析"
    filters:
      and:
        - 'entity_type == "valuation-agent-analysis"'
    order:
      - formula.entry
      - company
      - focus
      - analysis_summary
      - evidence_count
      - review_state
